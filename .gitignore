**/*_files/dp0/SYS/MECH/
**/*_files/dp0/SYS/MECH*/
*.rst
*.rth
*.rmg
*.rfl
*.esav
*.full
*.emat
*.mode
*.db
*.dbb
*.page
*.lock
.lock
.project_cache
**/*_files/.lock
**/*_files/.project_cache
**/*_files/user_files/~*
**/.*_files.backup/

# CAD temporary/lock files
~$*

# sw_assist debug captures (screen-assist tool output, not report figures)
**/cad/scripts/screenshots/
